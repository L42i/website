---
// Toc.astro — sticky page title + "Contents" navigation, built in the
// browser from the rendered article.
//
// Title: the page's <h1> is wrapped in a .page-head that sticks under the
// site header on every content page.
//
// Contents: every <h2>, plus every <details> that has a heading in its
// <summary>. No frontmatter or markup needed; pages with fewer than three
// sections get no menu. Wide screens: a fixed rail in the left margin with
// scroll-spy. Narrow screens: a collapsible bar that sticks with the title.
---

<nav class="toc" aria-label="Contents" hidden>
  <details>
    <summary>Contents</summary>
    <ol></ol>
  </details>
</nav>

<script is:inline>
  function build() {
    var toc = document.querySelector('.toc');
    var main = document.querySelector('main');
    if (!toc || !main) return;
    var root = document.documentElement;
    var header = document.querySelector('.site-header');

    // Sticky title. Only a top-level <h1>: sticky elements stick within
    // their parent, so the head must sit directly in <main>.
    var h1 = main.querySelector(':scope > h1');
    var head = null;
    if (h1) {
      head = document.createElement('div');
      head.className = 'page-head';
      h1.before(head);
      head.appendChild(h1);
    }

    // Header and title heights, for the sticky offset and for where a
    // jumped-to section should land (scroll-margin-top in global.css).
    function measure() {
      root.style.setProperty('--sticky-top', (header ? header.offsetHeight : 0) + 'px');
      root.style.setProperty('--head-h', (head ? head.offsetHeight : 0) + 'px');
    }
    measure();
    window.addEventListener('resize', measure);
    if (window.ResizeObserver) {
      var ro = new ResizeObserver(measure);
      if (header) ro.observe(header);
      if (head) ro.observe(head);
    }

    // A rule under the title once it has stuck, so text scrolling beneath
    // it does not look cut off.
    function stuck() {
      if (head) head.classList.toggle('is-stuck',
        head.getBoundingClientRect().top <= (header ? header.offsetHeight : 0) + 1 && window.scrollY > 0);
    }

    var used = {};
    var items = [];
    main.querySelectorAll('h2, details > summary').forEach(function (el) {
      if (el.closest('.toc') || el.classList.contains('pub-summary')) return;
      var isSummary = el.tagName === 'SUMMARY';
      var target = isSummary ? el.parentElement : el;
      var label = (el.textContent || '').replace(/\s+/g, ' ').trim();
      if (!label) return;
      if (!target.id) {
        var base = label.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'section';
        var id = base, n = 2;
        while (used[id] || document.getElementById(id)) id = base + '-' + n++;
        target.id = id;
      }
      used[target.id] = true;
      items.push({ target: target, label: label, details: isSummary });
    });

    var links = [];
    var wide = window.matchMedia('(min-width: 1500px)');
    if (items.length >= 3) {
      // On narrow screens the bar rides along under the title.
      if (head) head.appendChild(toc);
      var list = toc.querySelector('ol');
      links = items.map(function (it) {
        var li = document.createElement('li');
        var a = document.createElement('a');
        a.href = '#' + it.target.id;
        a.textContent = it.label;
        li.appendChild(a);
        list.appendChild(li);
        a.addEventListener('click', function (e) {
          e.preventDefault();
          // Collapse first, so the landing offset uses the closed bar's height.
          if (!wide.matches) toc.querySelector('details').open = false;
          measure();
          if (it.details) it.target.open = true;
          it.target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.replaceState(null, '', '#' + it.target.id);
        });
        return a;
      });

      // Rail is always expanded; the narrow bar starts collapsed.
      function sync() { toc.querySelector('details').open = wide.matches; measure(); }
      wide.addEventListener('change', sync);
      sync();
      toc.hidden = false;
      measure();
    }

    // Opening a link like /bikes#the-team lands inside a closed <details>.
    function openHash() {
      var t = location.hash && document.getElementById(location.hash.slice(1));
      if (t && t.tagName === 'DETAILS') t.open = true;
    }
    openHash();
    window.addEventListener('hashchange', openHash);

    // Scroll-spy: the last section whose top has passed the sticky bars.
    var ticking = false;
    function spy() {
      ticking = false;
      stuck();
      var top = (header ? header.offsetHeight : 0) + (head ? head.offsetHeight : 0);
      var line = Math.max(window.innerHeight * 0.3, top + 16), cur = -1;
      items.forEach(function (it, i) {
        if (it.target.getBoundingClientRect().top <= line) cur = i;
      });
      links.forEach(function (a, i) {
        a.classList.toggle('is-current', i === cur);
      });
    }
    window.addEventListener('scroll', function () {
      if (!ticking) { ticking = true; requestAnimationFrame(spy); }
    }, { passive: true });
    spy();
  }
  // The script sits above the article, so wait until the headings exist.
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', build);
  else build();
</script>
