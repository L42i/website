---
//Header.astro
import Navigation from './Navigation.astro';

// Neighbouring pages in the same section ({ url, title } or null).
const { prev = null, next = null, section = null } = Astro.props;
const href = (u: string) => `/${u}`.replace(/^\/\//, '/');
---

<header class="site-header">
  <div class="header-container">
    
    <a href="/" class="logo-link">
      <figure class="header-logo">
        <img 
          src="/assets/l42i.png" 
          alt="Site Logo" 
          class="logo-image"
        />
      </figure>
    </a>

    <nav class="header-nav">
      <Navigation />
    </nav>

  </div>

  {(prev || next) && (
    <div class="pager-bar">
      <nav class="pager" aria-label="Previous and next page in this section">
        {prev
          ? <a class="pager-link is-prev" href={href(prev.url)} rel="prev" title={prev.title}><span class="arrow">&#8249;</span><span class="label">{prev.title}</span></a>
          : <span></span>}
        {section
          ? <a class="pager-section" href={`/${section.id}`}>{section.label}</a>
          : <span></span>}
        {next
          ? <a class="pager-link is-next" href={href(next.url)} rel="next" title={next.title}><span class="label">{next.title}</span><span class="arrow">&#8250;</span></a>
          : <span></span>}
      </nav>
    </div>
  )}
</header>

<style>
  /* The global bar background framework */
  .site-header {
    width: 100%;
    background-color: #ffffff;
    border-bottom: 1px solid #e5e7eb;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  /* Keeps items locked inside a clear content grid */
    .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;

    /* Match the column formula exactly instead of hardcoded 1024px */
    width: min(100% - 2 * var(--gutter), var(--wide-width));
    margin: 0 auto;
    padding-block: 1rem;   /* vertical only — horizontal comes from the width formula */
    box-sizing: border-box;
  }

  /* Reset figure formatting margins */
  .logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .header-logo {
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
  }

  /* Constrain the image strictly so it doesn't blow up */
.logo-image {
    height: 50px;
    width: auto;
    max-width: none;  /* prevents global 80% rule from capping it */
    object-fit: contain;
    display: block;
}

  .pager-bar {
    border-top: 1px solid #f3f4f6;
    background: #fafafa;
  }
  .pager {
    width: min(100% - 2 * var(--gutter), var(--wide-width));
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding-block: 0.3rem;
    box-sizing: border-box;
    font-size: 0.85rem;
  }
  .pager-section {
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #111827;
    text-decoration: none;
  }
  .pager-section:hover { text-decoration: underline; }
  .pager-link.is-next { justify-self: end; }
  .pager-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
    max-width: 100%;
    color: #4b5563;
    text-decoration: none;
  }
  .pager-link:hover { color: #111827; }
  .pager-link:hover .label { text-decoration: underline; }
  .pager-link .label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pager-link .arrow { font-size: 1.3rem; line-height: 1; flex: none; }

  .header-nav {
    display: flex;
    align-items: center;
  }
</style>