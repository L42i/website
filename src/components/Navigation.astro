---
// Top-level section links. Add a section here to add a nav item.
const categoryLinks = [
  { id: 'projects', label: 'Projects' },
  { id: 'people', label: 'People' },
  { id: 'lab', label: 'Lab' },
  { id: 'courses', label: 'Courses' },
  { id: 'ga3d', label: '3DContest' },
  { id: 'events', label: 'Events' },
];
---

<div class="nav-menu-wrapper">
  <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links" aria-label="Menu">
    <span class="bar"></span><span class="bar"></span><span class="bar"></span>
  </button>
  <ul class="nav-links" id="nav-links">
    {categoryLinks.map((link) => (
      <li>
        <a href={`/${link.id}`} class="nav-item">{link.label}</a>
      </li>
    ))}
  </ul>
</div>

<script is:inline>
  // Phone menu: the links collapse behind a button. Without JS they simply
  // stay visible (the `js` class is what switches the collapsing on).
  (function () {
    document.documentElement.classList.add('js');
    var btn = document.querySelector('.nav-toggle');
    var wrap = document.querySelector('.nav-menu-wrapper');
    if (!btn || !wrap) return;
    function set(open) {
      wrap.classList.toggle('is-open', open);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    btn.addEventListener('click', function (e) { e.stopPropagation(); set(!wrap.classList.contains('is-open')); });
    document.addEventListener('click', function (e) { if (!wrap.contains(e.target)) set(false); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') set(false); });
  })();
</script>

<style>
  .nav-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-item {
    text-decoration: none;
    color: #4b5563;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    padding: 0.5rem 0.75rem;
    border-radius: 0.375rem;
    transition: all 0.2s ease-in-out;
    display: inline-block;
  }

  .nav-item:hover {
    color: #111827;
    background-color: #f3f4f6;
  }

  .nav-toggle { display: none; }

  @media (max-width: 640px) {
    .nav-toggle {
      display: inline-flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 2.5rem;
      height: 2.5rem;
      padding: 0 0.6rem;
      background: none;
      border: 0;
      cursor: pointer;
    }
    .nav-toggle .bar {
      display: block;
      height: 2px;
      background: #111827;
      border-radius: 1px;
      transition: transform 0.2s, opacity 0.2s;
    }
    .is-open .nav-toggle .bar:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .is-open .nav-toggle .bar:nth-child(2) { opacity: 0; }
    .is-open .nav-toggle .bar:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    /* Collapsed panel hanging under the header; only when JS can open it. */
    :global(html.js) .nav-links {
      display: none;
      position: absolute;
      left: calc(-1 * var(--gutter));
      right: calc(-1 * var(--gutter));
      top: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: #fff;
      border-bottom: 1px solid #e5e7eb;
      box-shadow: 0 8px 16px rgba(0, 0, 0, 0.06);
      padding: 0.25rem var(--gutter) 0.75rem;
    }
    :global(html.js) .is-open .nav-links { display: flex; }
    :global(html.js) .nav-item {
      display: block;
      padding: 0.8rem 0.25rem;
      border-radius: 0;
      border-bottom: 1px solid #f3f4f6;
      font-size: 1.05rem;
    }

    /* No JS: keep the links visible, wrapped, as before. */
    .nav-links { flex-wrap: wrap; justify-content: center; gap: 0.5rem; }
  }
</style>
