---
// BaseLayout.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import '../styles/global.css';

// variant: 'article' (default narrow column)
//        | 'wide'    (category listings)
//        | 'sidebar' (article + sticky right column; fill the "sidebar" slot)
const { title, variant = 'article' } = Astro.props;
const mainClass =
  variant === 'wide' ? 'category-container'
  : variant === 'sidebar' ? 'sidebar-layout'
  : 'content-post';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title || 'L42i'}</title>
  </head>
  <body>
    <Header />

    <main class={mainClass}>
      <slot />
    </main>
    <Footer />

    <!-- Lightbox for <div class="gallery"> images. Inert on pages with no
         gallery. Progressive enhancement: without JS the images are still
         shown inline, they just do not enlarge. -->
    <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Image viewer">
      <button class="lightbox-prev"  type="button" aria-label="Previous image">&#8249;</button>
      <img src="" alt="" />
      <button class="lightbox-next"  type="button" aria-label="Next image">&#8250;</button>
      <button class="lightbox-close" type="button" aria-label="Close">&times;</button>
      <span class="lightbox-count"></span>
    </div>

    <script is:inline>
      (function () {
        var imgs = Array.prototype.slice.call(
          document.querySelectorAll('.gallery img')
        );
        if (!imgs.length) return;

        var box   = document.getElementById('lightbox');
        var view  = box.querySelector('img');
        var count = box.querySelector('.lightbox-count');
        var i = 0;

        function show(n) {
          i = (n + imgs.length) % imgs.length;   // wrap both directions
          view.src = imgs[i].currentSrc || imgs[i].src;
          view.alt = imgs[i].alt || '';
          count.textContent = (i + 1) + ' / ' + imgs.length;
        }

        function open(n) {
          show(n);
          box.classList.add('is-open');
          box.classList.toggle('is-single', imgs.length < 2);
          document.body.style.overflow = 'hidden';  // freeze the page behind
        }

        function close() {
          box.classList.remove('is-open');
          document.body.style.overflow = '';
          view.src = '';
        }

        imgs.forEach(function (img, n) {
          img.addEventListener('click', function () { open(n); });
        });

        box.querySelector('.lightbox-close').addEventListener('click', close);
        box.querySelector('.lightbox-prev').addEventListener('click', function (e) {
          e.stopPropagation(); show(i - 1);
        });
        box.querySelector('.lightbox-next').addEventListener('click', function (e) {
          e.stopPropagation(); show(i + 1);
        });
        // Click anywhere on the backdrop closes; clicks on the image do not.
        box.addEventListener('click', function (e) {
          if (e.target === box) close();
        });
        view.addEventListener('click', function (e) { e.stopPropagation(); });

        document.addEventListener('keydown', function (e) {
          if (!box.classList.contains('is-open')) return;
          if (e.key === 'Escape') close();
          else if (e.key === 'ArrowLeft') show(i - 1);
          else if (e.key === 'ArrowRight') show(i + 1);
        });
      })();
    </script>

  </body>
</html>