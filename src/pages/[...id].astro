---
// src/pages/[...id].astro
// Content lives in src/content/<category>/*.md. Folders define the menu
// categories; URLs are FLAT by default (/bikes), and hierarchical only for
// the categories you opt in below (/courses/dsp).

import BaseLayout from '../layouts/BaseLayout.astro';
import Publications from '../components/Publications.astro';
import ContentList from '../components/ContentList.astro';
import { pubsFor } from '../lib/bibtex';

export async function getStaticPaths() {
  // ── URL policy ────────────────────────────────────────────────────────────
  // Categories listed here keep their folder in the URL (e.g. /courses/dsp).
  // Every other category is served flat (e.g. /bikes). Add "events" etc. here
  // whenever you want that category to be hierarchical.
  const NESTED_CATEGORIES = new Set(['courses', 'events', '3d-contest']);
  // ──────────────────────────────────────────────────────────────────────────

  // Title fallback chain: frontmatter.title -> first H1 -> prettified slug
  const deriveTitle = (fileInstance, slug) => {
    const fm = fileInstance.frontmatter || {};
    if (fm.title) return fm.title;
    const h1 = fileInstance.getHeadings?.().find((h) => h.depth === 1);
    if (h1?.text) return h1.text;
    return slug.replace(/[-_]/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
  };

  const markdownFiles = import.meta.glob('/src/content/**/*.{md,markdown}', {
    eager: true,
  });

  // Same files as raw text, so a listing thumbnail can be pulled from the
  // first image already in the page body. Avoids hand-adding `img:` to
  // every file; frontmatter still wins when present.
  const rawFiles = import.meta.glob('/src/content/**/*.{md,markdown}', {
    query: '?raw',
    import: 'default',
    eager: true,
  });

  const MD_IMG = /!\[[^\]]*\]\(\s*([^)\s]+)/;      // ![alt](/path.jpg)
  const HTML_IMG = /<img[^>]+src=["']([^"']+)["']/i; // <img src="/path.jpg">

  // Excerpt chain: frontmatter.description -> first real prose paragraph.
  // Works block by block so bullet lists (course registration details),
  // headings, images and italic captions are skipped rather than scraped.
  const deriveDescription = (fileInstance, filePath, limit = 150) => {
    const fm = fileInstance.frontmatter || {};
    if (fm.description) return fm.description;

    let raw = rawFiles[filePath];
    if (typeof raw !== 'string') return null;

    raw = raw.replace(/^---\n[\s\S]*?\n---\n/, '');
    raw = raw.replace(/```[\s\S]*?```/g, '\n\n');
    raw = raw.replace(
      /<(script|style|iframe|pre|audio|video|details)[^>]*>[\s\S]*?<\/\1>/gi,
      '\n\n'
    );

    for (const block of raw.split(/\n\s*\n/)) {
      let b = block.trim();
      if (!b) continue;
      if (b.startsWith('#')) continue;                  // heading
      if (/^\s*[-*+]\s/.test(b)) continue;              // bullet list
      if (/^\s*\d+\.\s/.test(b)) continue;              // numbered list
      if (b.startsWith('---') || b.startsWith('|')) continue;

      b = b.replace(/!\[[^\]]*\]\([^)]*\)/g, '');       // images
      b = b.replace(/<[^>]+>/g, ' ');                   // html tags
      b = b.replace(/\[([^\]]*)\]\([^)]*\)/g, '$1');    // links -> text

      // A whole line in italics is a caption, not a summary.
      if (/^[_*][\s\S]+[_*]$/.test(b.trim())) continue;

      b = b.replace(/[*_`>]/g, '');
      b = b.replace(/\s+/g, ' ').trim();
      if (b.length < 40) continue;                      // too short to be prose
      if (b.length <= limit) return b;
      return b.slice(0, limit).replace(/\s+\S*$/, '').replace(/[ ,;:.]+$/, '') + '\u2026';
    }
    return null;
  };

  // Thumbnail chain: frontmatter.img -> frontmatter.image -> first body image
  const deriveImage = (fileInstance, filePath) => {
    const fm = fileInstance.frontmatter || {};
    if (fm.img) return fm.img;
    if (fm.image) return fm.image;
    const raw = rawFiles[filePath];
    if (typeof raw !== 'string') return null;
    const m = raw.match(MD_IMG) || raw.match(HTML_IMG);
    return m ? m[1] : null;
  };

  // Parse every file into a normalized entry.
  const entries = Object.entries(markdownFiles).map(([filePath, fileInstance]) => {
    const parts = filePath.split('/');
    const category = parts[parts.indexOf('content') + 1] || '';
    const slug = parts[parts.length - 1].replace(/\.(md|markdown)$/, '');
    const nested = NESTED_CATEGORIES.has(category);
    return {
      filePath,
      fileInstance,
      category,
      slug,
      // The route id: "courses/dsp" if nested, otherwise just "dsp".
      url: nested ? `${category}/${slug}` : slug,
    };
  });

  const paths = [];
  const seen = new Map(); // route id -> source file (collision guard)

  // 1. One page per markdown file.
  for (const e of entries) {
    if (e.slug === 'index') continue;
    if (seen.has(e.url)) {
      console.warn(
        `[routing] Duplicate URL "/${e.url}": keeping ${seen.get(e.url)}, ` +
          `skipping ${e.filePath}. Rename one file, or make its category nested.`
      );
      continue;
    }
    seen.set(e.url, e.filePath);
    paths.push({
      params: { id: e.url },
      props: {
        type: 'content',
        fileInstance: e.fileInstance,
        title: deriveTitle(e.fileInstance, e.slug),
        // Optional bibliography: add `bib: bikes` (or a list) to the
        // markdown frontmatter and src/data/bib/bikes.bib gets rendered
        // as a Publications section below the content.
        bib: e.fileInstance.frontmatter?.bib ?? null,
        bibHeading: e.fileInstance.frontmatter?.bibHeading ?? 'Publications',
        // 'side'   = sticky right column
        // 'drawer' = pinned bottom drawer at all widths
        // 'inline' (default) = marker position, else bottom of the page
        bibPosition: e.fileInstance.frontmatter?.bibPosition ?? 'inline',
        // mobile: 'plain' (default) | 'collapse' | 'drawer'
        bibMobile: e.fileInstance.frontmatter?.bibMobile ?? 'plain',
      },
    });
  }

  // 2. One listing page per category folder (served at /<category>).
  const categories = [...new Set(entries.map((e) => e.category).filter(Boolean))];
  for (const category of categories) {
    if (seen.has(category)) {
      console.warn(
        `[routing] Category "/${category}" clashes with a flat page of the ` +
          `same name (${seen.get(category)}); skipping the listing page.`
      );
      continue;
    }
    const all = entries
      .filter((e) => e.category === category && e.slug !== 'index')
      .map((e) => ({
        url: e.url, // correct link target, flat or nested
        title: deriveTitle(e.fileInstance, e.slug),
        description: deriveDescription(e.fileInstance, e.filePath),
        img: deriveImage(e.fileInstance, e.filePath),
        // `status:` controls prominence in the listing.
        //   active   (default) full row with thumbnail and excerpt
        //   minor    compact text row, directly under the active ones
        //   archived compact text row, under an "Earlier" heading
        // Every page stays reachable at the same URL in all three cases.
        // `archived: true` is still honoured as a shorthand.
        status: (() => {
          const fm = e.fileInstance.frontmatter || {};
          if (fm.archived === true) return 'archived';
          const v = String(fm.status ?? 'active').toLowerCase();
          return ['active', 'minor', 'archived'].includes(v) ? v : 'active';
        })(),
        // `order:` sets the position in the listing, ASCENDING —
        // `order: 1` is first. Files without one sort to the bottom,
        // alphabetically, so a new page is visible but never jumps the
        // queue. Archived entries are ordered among themselves.
        order: Number.isFinite(Number(e.fileInstance.frontmatter?.order))
          ? Number(e.fileInstance.frontmatter.order)
          : Infinity,
      }))
      .sort((a, b) => a.order - b.order || a.title.localeCompare(b.title));

    paths.push({
      params: { id: category },
      props: {
        type: 'category',
        categoryName: category,
        files: all.filter((f) => f.status === 'active'),
        minorFiles: all.filter((f) => f.status === 'minor'),
        archivedFiles: all.filter((f) => f.status === 'archived'),
      },
    });
  }

  return paths;
}

// Section headings for the two lower tiers of a category listing.
// `active` pages are the unlabelled full rows at the top.
const MINOR_HEADING = 'More';
const ARCHIVE_HEADING = 'Archive';

const { type, fileInstance, title, categoryName, files, minorFiles, archivedFiles,
        bib, bibHeading,
        bibPosition, bibMobile } = Astro.props;
const Content = type === 'content' ? fileInstance.Content : null;

// Empty array when no `bib:` frontmatter — Publications renders nothing.
const pubs = type === 'content' ? pubsFor(bib) : [];

// `bibPosition: side` puts the list in a sticky, independently-scrolling
// right-hand column instead of in the flow of the article.
const useSidebar = pubs.length > 0 && bibPosition === 'side';

// `bibPosition: drawer` pins it to the bottom of the viewport on desktop too.
const useDrawer = pubs.length > 0 && bibPosition === 'drawer';

// ── Bibliography placement ────────────────────────────────────────────────
// Put <!--bib--> anywhere in the markdown to control where the publications
// section appears. With no marker (or no bib), the page renders normally via
// <Content /> and the section is appended at the end.
//
// When a marker IS present we render the compiled HTML directly instead of
// <Content />, so we can split it in two and slot the section between.
// Skipped entirely in sidebar mode — there the list isn't in the flow.
const BIB_MARKER = '<!--bib-->';
let bibSplit: [string, string] | null = null;

if (type === 'content' && pubs.length > 0 && !useSidebar && !useDrawer) {
  const html = String((await fileInstance.compiledContent?.()) ?? '');
  const at = html.indexOf(BIB_MARKER);
  if (at !== -1) {
    bibSplit = [html.slice(0, at), html.slice(at + BIB_MARKER.length)];
  }
}
---

{
  type === 'content' ? (
    <BaseLayout title={title} variant={useSidebar ? 'sidebar' : 'article'}>
      {useSidebar ? (
        <>
          <div class="content-post sidebar-main">
            <Content />
          </div>
          <aside class="sidebar-aside">
            <Publications pubs={pubs} heading={bibHeading} mobile={bibMobile} drawer={useDrawer} />
          </aside>
        </>
      ) : bibSplit ? (
        <>
          <Fragment set:html={bibSplit[0]} />
          <Publications pubs={pubs} heading={bibHeading} mobile={bibMobile} drawer={useDrawer} />
          <Fragment set:html={bibSplit[1]} />
        </>
      ) : (
        <>
          <Content />
          <Publications pubs={pubs} heading={bibHeading} mobile={bibMobile} drawer={useDrawer} />
        </>
      )}
    </BaseLayout>
  ) : (
    <BaseLayout title={categoryName} variant="wide">
      <h1 class="category-title">{categoryName}</h1>
      <p class="category-subtitle">
        Browsing all available files in the {categoryName} archive.
      </p>

      {files.length === 0 && minorFiles.length === 0 && archivedFiles.length === 0 ? (
        <div class="empty-state">
          <p>
            No markdown documents found in{' '}
            <code>src/content/{categoryName}/</code> yet.
          </p>
        </div>
      ) : (
        <ContentList items={files} />
      )}

      {minorFiles && minorFiles.length > 0 && (
        <section class="minor-section">
          <h2 class="minor-title">{MINOR_HEADING}</h2>
          <ContentList items={minorFiles} layout="compact" />
        </section>
      )}

      {/* Archived pages are the least prominent tier: collapsed to a single
          line, so they stay reachable without competing for attention.
          Plain <details> — closed by default, no script needed. */}
      {archivedFiles && archivedFiles.length > 0 && (
        <details class="archive-section">
          <summary class="archive-title">
            {ARCHIVE_HEADING}
            <span class="archive-count">{archivedFiles.length}</span>
          </summary>
          <ContentList items={archivedFiles} layout="compact" />
        </details>
      )}
    </BaseLayout>
  )
}
